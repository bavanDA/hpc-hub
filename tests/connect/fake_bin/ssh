#!/usr/bin/env python3
"""Fake ssh for tests: password + Duo via askpass, then a tiny Slurm."""
import os, signal, subprocess, sys, time

args = sys.argv[1:]
ctl = args[args.index("-S") + 1]
rest = args[args.index("--") + 2:]

if "-O" in args:
    op = args[args.index("-O") + 1]
    if op == "check":
        sys.exit(0 if os.path.exists(ctl) else 1)
    if op == "exit" and os.path.exists(ctl):
        pid = int(open(ctl).read())
        os.unlink(ctl)
        os.kill(pid, signal.SIGTERM)
    sys.exit(0)

def ask(prompt):
    r = subprocess.run([os.environ["SSH_ASKPASS"], prompt], capture_output=True, text=True)
    if r.returncode != 0:  # as real ssh: no answer from askpass ends the sign-in
        print("Permission denied (keyboard-interactive)", file=sys.stderr); sys.exit(255)
    return r.stdout.strip()

if "-M" in args:
    if ask("(u@fake) Password: ") != "pw":
        print("Permission denied", file=sys.stderr); sys.exit(255)
    menu = os.environ.get("FAKE_DUO_MENU")  # Duo's real menu: 1 push, 2 phone call, 3 texts, or a passcode
    if menu:
        q = ("Duo two-factor login for u\n\nEnter a passcode or select one of the following options:\n\n"
             " 1. Duo Push to XXX-XXX-1234\n 2. Phone call to XXX-XXX-1234\n 3. SMS passcodes to XXX-XXX-1234\n\n"
             "Passcode or option (1-3): ")
        code = os.environ.get("FAKE_DUO_CODE", "")
        got = ask(q)
        with open(os.environ["FAKE_SSH_LOG"], "a") as f:
            f.write(f"duo {got}\n")
        if got == "3":  # texts sent: Duo asks again, for one of them
            got = ask("New SMS passcodes sent.\n" + q)
            with open(os.environ["FAKE_SSH_LOG"], "a") as f:
                f.write(f"duo {got}\n")
            ok = bool(code) and got == code
        else:
            ok = got in ("1", "2") or (bool(code) and got == code)
        if not ok:
            print("Duo denied", file=sys.stderr); sys.exit(255)
    elif ask("Passcode or option (1-2): ") != "push":
        print("Duo denied", file=sys.stderr); sys.exit(255)
    open(ctl, "w").write(str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
    while True:
        time.sleep(1)

if not os.path.exists(ctl):
    sys.exit(255)
cmd = rest[0] if rest else ""
log = os.environ.get("FAKE_SSH_LOG")
if log:
    open(log, "a").write(cmd + "\n")
if cmd.startswith("salloc"):
    print("salloc: Pending job allocation 42")
    print("salloc: Granted job allocation 42")
elif "%i|%r" in cmd:  # node requests still waiting in the queue
    print(os.environ.get("FAKE_WAITING", "").replace(";", "\n"))
elif "%i|%j" in cmd:
    print(os.environ.get("FAKE_JOBS", "").replace(";", "\n"))
elif "%N" in cmd:
    print("n0001")
elif "%T" in cmd:
    print("RUNNING")
