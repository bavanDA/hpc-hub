#!/bin/bash
# trash: like rm, but files go to a .trash folder for 7 days, so they can be restored.
#   trash [-rf] path...    move to trash (rm-style flags are accepted and ignored)
#   trash --list           show what is in the trash
#   trash --empty          delete everything older than 7 days now
KEEP_DAYS=7
BINS="$HOME/.trash/.bins"  # every trash folder used, for --list and the 7-day cleanup

bin_for() {  # a .trash on the same disk as $1 (moving is instant), in the highest folder you own there
  local p d dev top=""
  p=$(realpath -m -- "$1"); d=$(dirname -- "$p")
  dev=$(stat -c %d -- "$d" 2>/dev/null) || { echo "$HOME/.trash"; return; }
  while [ "$d" != / ]; do
    [ -O "$d" ] && [ "$(stat -c %d -- "$d")" = "$dev" ] && top=$d
    d=$(dirname -- "$d")
  done
  if [ -n "$top" ]; then echo "$top/.trash"; else echo "$HOME/.trash"; fi  # never a shared folder like /tmp
}

remember() { mkdir -p "$HOME/.trash"; grep -qxF -- "$1" "$BINS" 2>/dev/null || printf '%s\n' "$1" >> "$BINS"; }

all_bins() {
  { echo "$HOME/.trash"; cat "$BINS" 2>/dev/null; } | awk '!seen[$0]++' |
    while read -r b; do [ -d "$b" ] && [ -O "$b" ] && echo "$b"; done
}

purge() { all_bins | while read -r b; do find "$b" -mindepth 1 -maxdepth 1 -type d -mtime +$KEEP_DAYS -exec /bin/rm -rf {} + 2>/dev/null; done; }

case "$1" in
  --list)  # day, where it was, where it is now
    all_bins | while read -r b; do
      for f in "$b"/*/*.from; do [ -e "$f" ] && printf '%s  %s  ->  %s\n' "$(basename "$(dirname "$f")")" "$(cat "$f")" "${f%.from}"; done
    done; exit 0 ;;
  --empty) purge; exit 0 ;;
esac

status=0 ended=0 force=0
for a in "$@"; do
  if [ $ended = 0 ] && [[ $a == -* ]]; then
    [[ $a == -- ]] && ended=1
    [[ $a == -*f* && $a != --* ]] && force=1
    continue
  fi
  if [ ! -e "$a" ] && [ ! -L "$a" ]; then
    [ $force = 1 ] || { echo "trash: $a: no such file or directory" >&2; status=1; }
    continue
  fi
  bin=$(bin_for "$a")
  day="$bin/$(date +%F)"
  mkdir -p "$day" || { status=1; continue; }
  remember "$bin"
  dest="$day/$(date +%H%M%S)-$$-$(basename -- "$a")"
  if mv -- "$a" "$dest"; then
    printf '%s\n' "$(realpath -m -- "$a")" > "$dest.from"
  else
    status=1
  fi
done
purge
exit $status
